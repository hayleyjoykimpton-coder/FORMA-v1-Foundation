# FORMA — local environment
# Copy to .env.local and fill from Supabase → Connect → .env.local

NEXT_PUBLIC_SUPABASE_URL=
# New Supabase publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy JWT anon key (optional fallback)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional — AI meal photo macros (server-only, never NEXT_PUBLIC_)
# Enables POST /api/analyze-meal. Without it, meal logging still works manually.
OPENAI_API_KEY=
# Optional model override (default gpt-4o-mini)
# OPENAI_MEAL_MODEL=gpt-4o-mini
