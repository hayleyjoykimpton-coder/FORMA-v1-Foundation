# FORMA — local environment
# Copy to .env.local and fill from Supabase → Connect → .env.local

NEXT_PUBLIC_SUPABASE_URL=
# New Supabase publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy JWT anon key (optional fallback)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional — AI meal photo macros + InBody screenshot import (server-only, never NEXT_PUBLIC_)
# Enables POST /api/analyze-meal and POST /api/analyze-inbody.
# Without it, meal logging and InBody manual entry still work.
OPENAI_API_KEY=
# Optional model override (default: gpt-4o for InBody sheets, gpt-4o-mini for meals)
# OPENAI_MEAL_MODEL=gpt-4o-mini
# OPENAI_INBODY_MODEL=gpt-4o
